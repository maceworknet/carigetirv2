{
    "name": "CG Proforma Default",
    "doctype": "Print Format",
    "doc_type": "CG Proforma Invoice",
    "custom_format": 1,
    "html": "\n<style>\n    .proforma-header { text-align: center; border-bottom: 2px solid #ddd; padding-bottom: 10px; margin-bottom: 20px; }\n    .proforma-details { margin-bottom: 30px; }\n    .proforma-table { width: 100%; border-collapse: collapse; }\n    .proforma-table th, .proforma-table td { border: 1px solid #ccc; padding: 8px; text-align: left; }\n    .proforma-totals { margin-top: 20px; width: 50%; float: right; }\n    .proforma-totals td { padding: 5px; }\n    .text-right { text-align: right !important; }\n</style>\n\n<div class=\"proforma-header\">\n    <h2>PROFORMA FATURA</h2>\n    <p>Belge No: {{ doc.name }} | Tarih: {{ doc.get_formatted(\"date\") }}</p>\n</div>\n\n<div class=\"proforma-details\">\n    <strong>Sayın:</strong><br>\n    {{ doc.customer }}<br>\n    Geçerlilik Tarihi: {{ doc.get_formatted(\"valid_until\") or '-' }}\n</div>\n\n<table class=\"proforma-table\">\n    <thead>\n        <tr>\n            <th>Ürün/Hizmet</th>\n            <th>Miktar</th>\n            <th>Birim</th>\n            <th class=\"text-right\">Birim Fiyat</th>\n            <th class=\"text-right\">İndirim</th>\n            <th class=\"text-right\">Tutar</th>\n        </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <td>{{ item.item_name }}<br><small>{{ item.description or '' }}</small></td>\n            <td>{{ item.qty }}</td>\n            <td>{{ item.uom }}</td>\n            <td class=\"text-right\">{{ item.get_formatted(\"rate\") }}</td>\n            <td class=\"text-right\">{{ item.get_formatted(\"discount\") }}</td>\n            <td class=\"text-right\">{{ item.get_formatted(\"amount\") }}</td>\n        </tr>\n        {% endfor %}\n    </tbody>\n</table>\n\n<table class=\"proforma-totals text-right\">\n    <tr>\n        <td><strong>Ara Toplam:</strong></td>\n        <td>{{ doc.get_formatted(\"subtotal\") }}</td>\n    </tr>\n    <tr>\n        <td><strong>İndirim:</strong></td>\n        <td>{{ doc.get_formatted(\"discount_amount\") }}</td>\n    </tr>\n    <tr>\n        <td><strong>KDV:</strong></td>\n        <td>{{ doc.get_formatted(\"tax_total\") }}</td>\n    </tr>\n    <tr>\n        <td><strong>Genel Toplam ({{ doc.currency }}):</strong></td>\n        <td><strong>{{ doc.get_formatted(\"grand_total\") }}</strong></td>\n    </tr>\n</table>\n\n<div style=\"clear: both;\"></div>\n\n<div style=\"margin-top: 50px;\">\n    <strong>Ödeme Şartları:</strong>\n    <p>{{ doc.payment_terms or '-' }}</p>\n    <strong>Notlar:</strong>\n    <p>{{ doc.notes or '-' }}</p>\n</div>\n",
    "module": "carigetir_erp",
    "print_format_builder": 0
}